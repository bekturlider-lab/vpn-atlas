PORT=3000
HOST=0.0.0.0
# Real blocking is enabled by default. IP addresses geolocated to KG are denied.
GEOBLOCK_ENABLED=true
GEOIP_DB_PATH=./data/dbip-country-lite.mmdb
# Optional outside Render. Render enables automatic free database downloads by default.
# GEOIP_AUTO_DOWNLOAD=true
# Empty = direct connection. Set only the addresses/CIDRs of YOUR reverse proxies.
# Example for Nginx on the same machine: TRUSTED_PROXIES=127.0.0.1/32,::1/128
TRUSTED_PROXIES=
